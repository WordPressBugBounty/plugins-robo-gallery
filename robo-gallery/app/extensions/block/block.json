{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "robo/block-robo-gallery",
    "title": "Robo Gallery",
    "category": "media",
    "icon": "format-gallery",
    "description": "Shows a gallery made with Robo Gallery.",
    "keywords": ["robo", "robogallery", "gallery", "images", "photos"],
    "textdomain": "robo-gallery",
    "attributes": {
        "galleryid": {
            "type": ["number", "string"],
            "default": 0
        },
        "popup": {
            "type": "string",
            "enum": ["", "button", "link"],
            "default": ""
        },
        "popupText": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "file:./build/index.js",
    "editorStyle": "file:./build/index.css"
}
